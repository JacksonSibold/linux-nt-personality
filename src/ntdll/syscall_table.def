/*
 * syscall_table.def
 *
 * Frozen NT system-service table for Windows Server 2022 x64
 * (build 10.0.20348).  SSNs sourced from j00ru/windows-syscalls.
 *
 * This file is the single source of truth for both the ntdll stubs
 * and the kernel dispatch table.  Add new services only at the end;
 * existing SSNs must never change.
 *
 * Macro shape: NT_SYSCALL(Name, Ssn, Arity, ArgTypes...)
 */

#ifndef NT_SYSCALL
#define NT_SYSCALL(Name, Ssn, Arity, ...)
#endif

